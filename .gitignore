*.pcapng
*.cap
*.bin
*.db
*.sqlite
*.rdb

# Local credentials, logs and archives
.env
*.key
*.pem
*.log
*.tar
*.tar.gz
*.zip

# Python
__pycache__/
*.pyc
venv/
.venv/
yamcs-venv/
